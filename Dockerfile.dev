FROM rust:1-bookworm

WORKDIR /app

# lib/SimConnect.dll намеренно не копируется: она нужна только Windows-сборке
# (include_bytes! в src/sim/worker.rs под cfg(windows)), а здесь гоняются
# кроссплатформенные lib+integration тесты.
COPY Cargo.toml Cargo.lock ./
COPY src ./src
COPY tests ./tests

RUN cargo test --lib --tests --locked

CMD ["cargo", "test", "--lib", "--tests", "--locked"]
